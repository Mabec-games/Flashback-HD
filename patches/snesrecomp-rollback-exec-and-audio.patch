+/* A rollback keeps the live delivery state, as it keeps the output ring: the
+ * consumer is mid-stream and the guest is going back exactly where it was.
+ * Resetting it (as a real load must) re-primed the audio on every rollback,
+ * so a host rolling back each frame (run-ahead, speculative rendering)
+ * output silence and stalled the producer behind the refilling cushion. */
+struct RtlAudioDelivery {
+  double phase, occ_ema;
+  int16 hold_l, hold_r;
+  int starved, fade_pos, fade_out;
+  bool priming;
+};
+static RtlAudioDelivery s_rollback_delivery;
+
+static RtlAudioDelivery *rtl_audio_delivery_save(void) {
+  s_rollback_delivery = (RtlAudioDelivery){
+    s_render_phase, s_render_occ_ema, s_render_hold_l, s_render_hold_r,
+    s_render_starved, s_render_fade_pos, s_render_fade_out, s_render_priming};
+  return &s_rollback_delivery;
+}
+
+static void rtl_audio_delivery_restore(const RtlAudioDelivery *saved) {
+  s_render_phase = saved->phase;
+  s_render_occ_ema = saved->occ_ema;
+  s_render_hold_l = saved->hold_l;
+  s_render_hold_r = saved->hold_r;
+  s_render_starved = saved->starved;
+  s_render_fade_pos = saved->fade_pos;
+  s_render_fade_out = saved->fade_out;
+  s_render_priming = saved->priming;
+}
