+
+int snes_beam_frame_driver_exec_state_load(const void *in, size_t size) {
+  BeamExecState st;
+  if (size != sizeof st)
+    return 0;
+  memcpy(&st, in, sizeof st);
+  s_resume_pc = st.resume_pc;
+  s_wai_halted = st.wai_halted != 0;
+  return 1;
+}
