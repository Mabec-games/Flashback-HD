+  double phase, occ_ema;
+  int16 hold_l, hold_r;
+  int starved, fade_pos, fade_out;
+  bool priming;
+};
+static RtlAudioDelivery s_rollback_delivery;
+
+static RtlAudioDelivery *rtl_audio_delivery_save(void) {
+  s_rollback_delivery = (RtlAudioDelivery){
