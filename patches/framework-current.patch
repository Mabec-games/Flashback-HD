+    s_render_starved, s_render_fade_pos, s_render_fade_out, s_render_priming};
+  return &s_rollback_delivery;
+}
+
+static void rtl_audio_delivery_restore(const RtlAudioDelivery *saved) {
+  s_render_phase = saved->phase;
+  s_render_occ_ema = saved->occ_ema;
+  s_render_hold_l = saved->hold_l;
+  s_render_hold_r = saved->hold_r;
+  s_render_starved = saved->starved;
+  s_render_fade_pos = saved->fade_pos;
+  s_render_fade_out = saved->fade_out;
+  s_render_priming = saved->priming;
+}
