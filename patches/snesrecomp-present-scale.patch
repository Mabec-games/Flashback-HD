@@ -197,6 +197,13 @@ typedef struct SnesDesktopHostGame {
   /* After the gameplay loop ends, before SDL resources are destroyed or a
    * relaunch begins. Stop title-owned workers here. No further frames run. */
   void (*on_shutdown)(void);
+  /* Present above the guest resolution. Return N (2..8) to have the host
+   * acquire an N-times larger presentation frame and pass that size to
+   * draw_frame, which can then draw at output resolution (a title's own HD
+   * renderer). If draw_frame returns 0 the host nearest-neighbour scales the
+   * PPU field. Window sizing, aspect and the guest frame are unchanged.
+   * NULL, or a return below 2, presents the native frame exactly as before. */
+  int (*present_scale)(void);
 } SnesDesktopHostGame;
 
